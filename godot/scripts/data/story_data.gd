static var _all_events := []


## Every event, in the order they are tried: the story's own, then romance, then errands.
static func all_events() -> Array:
	if _all_events.is_empty():
		_all_events = EVENTS + QuestsData.romance_events() + QuestsData.quest_events()
	return _all_events
